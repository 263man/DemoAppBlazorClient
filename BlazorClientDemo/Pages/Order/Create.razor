@page "/order/create"
@inject HttpClient Http
@inject NavigationManager navigationManager

<h3>Create</h3>

@if(string.IsNullOrWhiteSpace(errorString)==false)
{
    <h4>System Error</h4>
    <p>@errorString</p>
}
else if(foodItems.Count == 0)
{
    <h4>Loading...</h4>
}
else
{
    <EditForm Model="@order" OnValidSubmit="HandleValidSubmit" FormName="OrderForm">
        <DataAnnotationsValidator />
        <ValidationSummary Model="@order" />

        <div class="form-group mb-3">
            <label class="control-label">Item to Order</label>
            <InputSelect @bind-value="order.FoodId" class="form-control">
                @if(foodItems.Any() == true)
                {
                    <option value="0">Select a meal...</option>

                    @foreach (var f in foodItems)
                    {
                        <option value="@f.Id">@f.Title</option>
                    }
                }
                else
                {
                    <option value="0" disabled>Loading meals...</option>
                }
            </InputSelect>
            @* Validation message correctly requires FoodId >= 1 *@
            <ValidationMessage For="@(() => order.FoodId)" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Quantity</label>
            <InputNumber @bind-value="order.Quantity" class="form-control" />
            <ValidationMessage For="@(() => order.Quantity)" class="text-danger" />
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Name for the Order</label>
            <InputText @bind-value="order.OrderName" class="form-control" />
            <ValidationMessage For="@(() => order.OrderName)" class="text-danger" />
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Order Food</button>
        </div>
    </EditForm>
}

@code {
    private OrderModel order = new OrderModel();
    private List<FoodModel> foodItems = new List<FoodModel>();
    private string? errorString;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            errorString = null;
            HttpResponseMessage httpResponse = await Http.GetAsync("api/food");
            if(httpResponse.IsSuccessStatusCode)
            {
                foodItems = await httpResponse.Content.ReadFromJsonAsync<List<FoodModel>>() ?? new List<FoodModel>();
                if(foodItems.Any() is not true)
                {
                    Console.WriteLine("API returned success but no food items");
                }
            }
            else
            {
                errorString = $"Error fetching food items: {httpResponse.StatusCode} - {httpResponse.ReasonPhrase}";
                Console.WriteLine(errorString);
            }
        }
        catch(Exception ex)
        {
            errorString = $"An exception occured while loading food items: {ex.Message}";
            Console.WriteLine(errorString);
            Console.WriteLine(ex.ToString());
        }
    }

    private async Task HandleValidSubmit()
    {
        var selectedFood = foodItems.FirstOrDefault(x => x.Id == order.FoodId);
        if (selectedFood != null)
        {
            order.Total = order.Quantity * selectedFood.Price;
        }
        else
        {
            errorString = "Selected food item is not valid.";
            return; // Don't proceed with submission
        }

        try
               {
                   var httpResponse = await Http.PostAsJsonAsync("api/order", order);
                   if (httpResponse.IsSuccessStatusCode)
                   {
                       var contents = await httpResponse.Content.ReadFromJsonAsync<OrderCreateResultsModel>();
                       if (contents != null)
                       {
                           order = new OrderModel();
                           navigationManager.NavigateTo($"order/display/{contents.Id}");
                       }
                       else
                       {
                           errorString = "Unexpected response from the server.";
                       }
                   }
                   else
                   {
                       errorString = $"Error creating order: {httpResponse.StatusCode} - {httpResponse.ReasonPhrase}";
                   }
               }
               catch (Exception ex)
               {
                   errorString = $"An error occurred: {ex.Message}";
               }
    }
}
