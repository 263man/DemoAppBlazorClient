@page "/Order/Display/{id:int}"
@inject HttpClient Http
@inject NavigationManager navigationManager

<h3 class="mb-4">Order Details</h3>

@if (!string.IsNullOrWhiteSpace(errorString))
{
    <div class="alert alert-danger">
        <h5 class="alert-heading">System Error</h5>
        <p>@errorString</p>
    </div>
}
else if (orderInfo.Order is null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading order...</p>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>Order Summary</strong>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row">Order Name</th>
                        <td>@orderInfo.Order.OrderName</td>
                    </tr>
                    <tr>
                        <th scope="row">Order Date</th>
                        <td>@orderInfo.Order.OrderDate.ToShortDateString()</td>
                    </tr>
                    <tr>
                        <th scope="row">Order Total</th>
                        <td>@string.Format("{0:C}", orderInfo.Order.Total)</td>
                    </tr>
                    <tr>
                        <th scope="row">Item Ordered</th>
                        <td>@orderInfo.ItemPurchased</td>
                    </tr>
                    <tr>
                        <th scope="row">Quantity Ordered</th>
                        <td>@orderInfo.Order.Quantity</td>
                    </tr>
                </tbody>
            </table>
            <div class="text-end">
                @if (confirmDelete)
                {
                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-outline-danger" @onclick="HandleDeleteRecord">Confirm Delete</button>
                        <button class="btn btn-secondary" @onclick="(() => confirmDelete = false)">Cancel</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-danger" @onclick="(() => confirmDelete = true)">
                        <i class="bi bi-trash"></i> Delete Order
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Update Order</strong>
        </div>
        <div class="card-body">
            <EditForm Model="@updateModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator/>
                <ValidationSummary/>

                <div class="mb-3">
                    <label class="form-label">Order Name</label>
                    <InputText @bind-Value="updateModel.OrderName" class="form-control" />
                    <ValidationMessage For="@(() => updateModel.OrderName)" class="text-danger" />
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Update Order
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private OrderResultsModel orderInfo = new()
        {
            Order = default!,
            ItemPurchased = string.Empty
        };

    private string? errorString;
    private OrderUpdateModel updateModel = new();
    private bool confirmDelete = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            HttpResponseMessage response = await Http.GetAsync($"api/order/{Id}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<OrderResultsModel>();
                if (result is not null)
                {
                    orderInfo = result;
                    updateModel.Id = result.Order.Id;
                    updateModel.OrderName = result.Order.OrderName;
                }
                else
                {
                    errorString = "Failed to deserialize order information.";
                }
            }
            else
            {
                errorString = response.ReasonPhrase;
            }
        }
        catch (Exception ex)
        {
            errorString = $"An error occurred: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            HttpResponseMessage response = await Http.PutAsJsonAsync("api/order", updateModel);
            if (response.IsSuccessStatusCode)
            {
                orderInfo.Order.OrderName = updateModel.OrderName;
            }
            else
            {
                errorString = $"Update failed: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            errorString = $"An error occurred during update: {ex.Message}";
        }
    }

    private async Task HandleDeleteRecord()
    {
        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"api/order/{Id}");
            if (response.IsSuccessStatusCode)
            {
                navigationManager.NavigateTo("food/List");
            }
            else
            {
                errorString = $"Delete failed: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            errorString = $"An error occurred during delete: {ex.Message}";
        }
    }
}
